<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Crucial for WebKit / Safari JavaScriptCore JIT compilation (prevents WebProcess SIGKILL/crash) -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <!-- Network access for local AI (Ollama/LM Studio) and cloud endpoints -->
    <key>com.apple.security.network.client</key>
    <true/>
    <key>com.apple.security.network.server</key>
    <true/>

    <!-- User file access for attachments, database exports, and vault -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
</dict>
</plist>
